FrameWidgetClass BDE_VG2_Root {
 visible 1
 color 0 0 0 0
 position 0 0
 size 1 1
 halign fill
 valign fill
 {
 PanelWidgetClass HeaderPanel {
  visible 1
  position 0 0
  size 200 60
  hexactpos 1
  vexactpos 1
  hexactsize 1
  vexactsize 1
  color 0.006 0.012 0.035 0.97
  style rover_sim_colorable
  {
   TextWidgetClass TitleText {
    visible 1
    position 0 0
    size 200 60
    hexactpos 1
    vexactpos 1
    hexactsize 1
    vexactsize 1
    color 0.94 0.96 1 1
    text "BDE VIRTUAL GARAGE"
    font "gui/fonts/Metron28"
    "text valign" center
   }
   TextWidgetClass VersionText {
    visible 1
    position 0 0
    size 200 60
    hexactpos 1
    vexactpos 1
    hexactsize 1
    vexactsize 1
    color 0.65 0.75 0.84 1
    text "v2.8.0"
    font "gui/fonts/Metron22"
    "text halign" right
   }
   ButtonWidgetClass CloseButton {
    visible 1
    position 0 0
    size 200 60
    hexactpos 1
    vexactpos 1
    hexactsize 1
    vexactsize 1
    color 0.30 0.01 0.02 1
    text "X"
    font "gui/fonts/Metron28"
   }
   TextWidgetClass AccessText {
    visible 1
    position 0 0
    size 200 60
    hexactpos 1
    vexactpos 1
    hexactsize 1
    vexactsize 1
    color 0.94 0.96 1 1
    text "STORE RANGE"
    font "gui/fonts/Metron22"
    "text valign" center
   }
   TextWidgetClass SummaryText {
    visible 1
    position 0 0
    size 200 60
    hexactpos 1
    vexactpos 1
    hexactsize 1
    vexactsize 1
    color 0.65 0.75 0.84 1
    text "BDE VEHICLE LOCKS OWNERSHIP  |  LIVE EXPANSION GROUP ACCESS"
    font "gui/fonts/Metron22"
    "text valign" center
   }
   TextWidgetClass CountText {
    visible 1
    position 0 0
    size 200 60
    hexactpos 1
    vexactpos 1
    hexactsize 1
    vexactsize 1
    color 0.23 0.73 0.47 1
    text "NEARBY VEHICLES: 0"
    font "gui/fonts/Metron22"
    "text valign" center
   }
   ButtonWidgetClass RefreshButton {
    visible 1
    position 0 0
    size 200 60
    hexactpos 1
    vexactpos 1
    hexactsize 1
    vexactsize 1
    color 0.025 0.16 0.25 1
    text "REFRESH LIVE DATA"
    font "gui/fonts/Metron18"
   }
  }
 }
