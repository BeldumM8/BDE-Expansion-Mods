 PanelWidgetClass ConfirmationPanel {
  visible 0
  position 0 0
  size 200 60
  hexactpos 1
  vexactpos 1
  hexactsize 1
  vexactsize 1
  color 0 0 0 0.76
  style rover_sim_colorable
  priority 50
  {
   PanelWidgetClass ConfirmBorder {
    visible 1
    position 0 0
    size 200 60
    hexactpos 1
    vexactpos 1
    hexactsize 1
    vexactsize 1
    color 0.003 0.007 0.013 0.97
    style rover_sim_colorable
    {
     TextWidgetClass ConfirmTitle {
      visible 1
      position 0 0
      size 200 60
      hexactpos 1
      vexactpos 1
      hexactsize 1
      vexactsize 1
      color 0.94 0.96 1 1
      text "ORIGINAL POSITION BLOCKED"
      font "gui/fonts/Metron28"
      "text halign" center
      "text valign" center
     }
     MultilineTextWidgetClass ConfirmText {
      visible 1
      position 0 0
      size 200 60
      hexactpos 1
      vexactpos 1
      hexactsize 1
      vexactsize 1
      color 0.94 0.96 1 1
      text ""
      font "gui/fonts/Metron22"
      wrap 1
      "size to text h" 0
      "size to text v" 0
      "text halign" left
      "text valign" top
     }
     ButtonWidgetClass ConfirmYesButton {
      visible 1
      position 0 0
      size 200 60
      hexactpos 1
      vexactpos 1
      hexactsize 1
      vexactsize 1
      color 0.02 0.34 0.14 1
      text "RETRIEVE AT SAFE POSITION"
      font "gui/fonts/Metron22"
     }
     ButtonWidgetClass ConfirmNoButton {
      visible 1
      position 0 0
      size 200 60
      hexactpos 1
      vexactpos 1
      hexactsize 1
      vexactsize 1
      color 0.40 0.02 0.02 1
      text "CANCEL"
      font "gui/fonts/Metron22"
     }
    }
   }
  }
 }
